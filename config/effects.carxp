 <!-- Calf Pulsator -->
 <Plugin>
  <Info>
   <Type>LV2</Type>
   <Name>Calf Pulsator</Name>
   <URI>http://calf.sourceforge.net/plugins/Pulsator</URI>
  </Info>

  <Data>
   <Active>Yes</Active>
   <ControlChannel>1</ControlChannel>
   <Options>0x3f1</Options>

   <Parameter>
    <Index>0</Index>
    <Name>Bypass</Name>
    <Symbol>bypass</Symbol>
    <MidiChannel>15</MidiChannel>
    <MappedControlIndex>92</MappedControlIndex>
    <MappedMinimum>1</MappedMinimum>
    <MappedMaximum>0</MappedMaximum>
    <MidiCC>92</MidiCC>
    <Value>1</Value>
   </Parameter>

   <Parameter>
    <Index>1</Index>
    <Name>Input Gain</Name>
    <Symbol>level_in</Symbol>
    <Value>1</Value>
   </Parameter>

   <Parameter>
    <Index>2</Index>
    <Name>Output Gain</Name>
    <Symbol>level_out</Symbol>
    <Value>1</Value>
   </Parameter>

   <Parameter>
    <Index>11</Index>
    <Name>Mode</Name>
    <Symbol>mode</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>12</Index>
    <Name>Modulation</Name>
    <Symbol>amount</Symbol>
    <MidiChannel>15</MidiChannel>
    <MappedControlIndex>3</MappedControlIndex>
    <MappedMinimum>0</MappedMinimum>
    <MappedMaximum>1</MappedMaximum>
    <MidiCC>3</MidiCC>
    <Value>0.755905508995056</Value>
   </Parameter>

   <Parameter>
    <Index>13</Index>
    <Name>Offset L</Name>
    <Symbol>offset_l</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>14</Index>
    <Name>Offset R</Name>
    <Symbol>offset_r</Symbol>
    <Value>0.5</Value>
   </Parameter>

   <Parameter>
    <Index>15</Index>
    <Name>Mono-in</Name>
    <Symbol>mono</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>16</Index>
    <Name>Reset</Name>
    <Symbol>reset</Symbol>
    <Value>0</Value>
   </Parameter>

   <Parameter>
    <Index>17</Index>
    <Name>Pulse Width</Name>
    <Symbol>pulsewidth</Symbol>
    <Value>2</Value>
   </Parameter>

   <Parameter>
    <Index>18</Index>
    <Name>Timing</Name>
    <Symbol>timing</Symbol>
    <Value>2</Value>
   </Parameter>

   <Parameter>
    <Index>19</Index>
    <Name>BPM</Name>
    <Symbol>bpm</Symbol>
    <Value>120</Value>
   </Parameter>

   <Parameter>
    <Index>20</Index>
    <Name>ms</Name>
    <Symbol>ms</Symbol>
    <Value>500</Value>
   </Parameter>

   <Parameter>
    <Index>21</Index>
    <Name>Frequency</Name>
    <Symbol>hz</Symbol>
    <MidiChannel>15</MidiChannel>
    <MappedControlIndex>9</MappedControlIndex>
    <MappedMinimum>0.00999999977648258</MappedMinimum>
    <MappedMaximum>100</MappedMaximum>
    <MidiCC>9</MidiCC>
    <Value>2.86215353012085</Value>
   </Parameter>
  </Data>
 </Plugin>

