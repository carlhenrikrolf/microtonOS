 <!-- REEV-R -->
 <Plugin>
  <Info>
   <Type>LV2</Type>
   <Name>REEV-R</Name>
   <URI>https://github.com/tiagolr/reevr</URI>
  </Info>

  <Data>
   <Active>Yes</Active>
   <ControlChannel>1</ControlChannel>
   <Options>0x3f1</Options>
  </Data>
 </Plugin>

 <Patchbay>
