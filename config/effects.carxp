  <SFZ_PATH>/home/pi/.sounds/sfz:/usr/share/sounds/sfz</SFZ_PATH>
  <JSFX_PATH>/home/pi/.config/REAPER/Effects</JSFX_PATH>
  <CLAP_PATH>/home/pi/.clap:/usr/lib/clap:/usr/local/lib/clap:/home/pi/.wine/drive_c/Program Files/Common Files/CLAP:/home/pi/.wine/drive_c/Program Files (x86)/Common Files/CLAP</CLAP_PATH>
