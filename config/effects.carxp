    <Symbol>on</Symbol>
    <MidiChannel>15</MidiChannel>
    <MappedControlIndex>93</MappedControlIndex>
    <MappedMinimum>0</MappedMinimum>
    <MappedMaximum>1</MappedMaximum>
    <MidiCC>93</MidiCC>
