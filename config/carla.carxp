    &lt;MappedMaximum&gt;0.990000009536743&lt;/MappedMaximum&gt;
    &lt;MidiCC&gt;26&lt;/MidiCC&gt;
    &lt;Value&gt;-0.0389763601124287&lt;/Value&gt;
