[Unit]
Description=Start Carla as a subprocess to its wrapper
After=graphical.target
Requires=qjackctl.service

[Service]
User=pi
Environment=XDG_RUNTIME_DIR="/run/user/1000"
Environment=DISPLAY=:0
WorkingDirectory=/home/pi/microtonOS/tmp/
ExecStart=/home/pi/microtonOS/.venv/bin/python3 /home/pi/microtonOS/src/wrappers/carla.py
Restart=always
RestartSec=2s
TimeoutSec=infinity

[Install]
WantedBy=graphical.target
